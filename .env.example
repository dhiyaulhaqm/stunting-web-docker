# Public port for the web application. Change if 8080 is already used.
APP_PORT=8080

# Application and MySQL credentials. Replace every example value before deploy.
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
DB_NAME=db_stunting
DB_USERNAME=stunting_user
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# The initial admin is created only when no admin exists in the database.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
